NEXT_PUBLIC_API_URL=https://router-merit-ground-nutrition.trycloudflare.com/api
API_URL=https://router-merit-ground-nutrition.trycloudflare.com/api
NEXT_PUBLIC_PAYMENTS_SIMULATE=true

# Server-only. Must equal FRONTEND_PROXY_SECRET in the backend: lets the API proxy pass on the visitor IP/browser
# (needed for correct rate limits and campaign/affiliate visit counting). Never prefix with NEXT_PUBLIC_.
API_PROXY_SECRET=

# reCAPTCHA site key (public). Pair it with RECAPTCHA_SECRET_KEY on the backend. Empty = no captcha.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# 2 = "I'm not a robot" checkbox (needs a v2 Checkbox key), 3 = invisible (v3 key). Default 3.
NEXT_PUBLIC_RECAPTCHA_VERSION=3

# Moyasar publishable key (pk_...). Set it to pay with real cards; leave empty for the fake development gateway.
# The backend needs PAYMENTS_DRIVER=moyasar and MOYASAR_SECRET_KEY.
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=
